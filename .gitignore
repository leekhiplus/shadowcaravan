# Godot 4 generated caches (regenerated by `godot --import`)
.godot/
.import/
*.translation

# Build output (CI uploads build/ShadowCaravan.apk as an artifact)
/build/*
!/build/.gitkeep

# Signing material and credentials - NEVER commit these
*.keystore
*.jks
export_credentials.cfg
.env
secrets/

# Android build template (only if you switch to Gradle builds)
/android/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tmp
*~
